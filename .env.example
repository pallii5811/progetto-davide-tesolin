# Copiare in `.env` e valorizzare. Il file `.env` è in .gitignore e non va mai committato.
#
# Nessuna di queste variabili è obbligatoria per vedere la piattaforma funzionare: senza
# alcun file `.env` parte in modalità dimostrativa, su dati fittizi e senza spendere nulla.


# ── Fonte dati aziendali ─────────────────────────────────────────────────────

# Token OpenAPI.com. Senza, la piattaforma parte in modalità dimostrativa.
OPENAPI_TOKEN=

# Ambiente: "test" usa il sandbox (chiamate gratuite, dati fittizi),
# "produzione" usa i dati reali e consuma credito.
OPENAPI_AMBIENTE=test

# Tetto di spesa per singola sessione di lavoro, in centesimi.
# Superata la soglia, il client rifiuta di effettuare nuove chiamate a pagamento.
# È una difesa contro il ciclo che va in errore e riprova: senza, il credito si esaurisce
# prima che qualcuno se ne accorga.
OPENAPI_BUDGET_CENTESIMI=200


# ── Prezzi effettivi dei servizi dati ────────────────────────────────────────

# I prezzi predefiniti nel codice sono quelli di listino a CHIAMATA SINGOLA.
# In abbonamento a volume gli stessi servizi costano una frazione: l'analisi
# approfondita passa da 0,85 € a circa 0,18 €, cioè quasi cinque volte meno.
#
# Non è un dettaglio di visualizzazione: questi numeri governano il tetto di spesa,
# il credito residuo e il preventivo mostrato PRIMA di acquistare.
# Vanno allineati alle proprie condizioni contrattuali, leggibili dalla console del
# fornitore.
#
# Formato: servizio=centesimi, separati da virgola.
# AEGIS_PREZZI_CENTESIMI=anagraficaEstesa=3,eventiNegativi=6,profiloCompleto=9


# ── Tetti di spesa e credito ─────────────────────────────────────────────────

# Tetto giornaliero **per singolo studio**, in centesimi. Difende ciascuno dal proprio
# errore: l'importazione lanciata due volte, il filtro impostato male. Raggiunto il tetto,
# le operazioni a pagamento vengono rifiutate; il conteggio dei prospect resta gratuito.
# Zero disattiva il controllo. Predefinito: 2000 (20 €).
# AEGIS_TETTO_SPESA_GIORNALIERO_CENTESIMI=2000

# Tetto giornaliero **complessivo**, su tutti gli studi insieme.
#
# Serve quando un solo contratto dati serve più intermediari: dieci studi ciascuno entro
# il proprio tetto esauriscono comunque il credito, e si fermano tutti nello stesso
# istante — compresi i nove che non hanno sbagliato nulla.
#
# Zero, il predefinito, lo disattiva: su un'installazione con un solo studio sarebbe un
# secondo limite che duplica il primo e rende incomprensibile il rifiuto.
# AEGIS_TETTO_SPESA_COMPLESSIVO_CENTESIMI=0

# Credito caricato sul contratto dati, in centesimi. Serve solo a calcolare il residuo per
# differenza con quanto il registro dei costi ha segnato, e va riallineato a ogni ricarica:
# è una dichiarazione di chi gestisce la piattaforma, non un dato letto dal fornitore.
# Lasciandola a zero il residuo non viene mostrato — meglio del numero sbagliato.
# AEGIS_CREDITO_CARICATO_CENTESIMI=0


# ── Archivio ─────────────────────────────────────────────────────────────────

# PostgreSQL di produzione. Se assente si usa PGlite su disco, che è PostgreSQL vero
# compilato in WebAssembly: nessun servizio da installare, dati che sopravvivono al riavvio.
#
# ATTENZIONE: impostandola, lo schema NON viene creato all'avvio. Prima di avviare il
# servizio applicare le migrazioni versionate:
#
#   DATABASE_URL=… npm run migra
#
# DATABASE_URL=postgresql://utente:password@host:5432/aegis

# Cartella del cluster PGlite. Vale solo quando DATABASE_URL è assente.
# Il valore predefinito è `.dati/` nella radice del progetto — ancorato alla radice, non
# alla cartella da cui si lancia il comando, per non ritrovarsi con due archivi distinti.
# AEGIS_DATA_DIR=./.dati


# ── Primo accesso ────────────────────────────────────────────────────────────

# Denominazione dell'intermediario creato al primo avvio.
# AEGIS_TENANT=Studio Rossi Assicurazioni

# Indirizzo del primo amministratore. La sua password viene generata dal sistema e
# stampata a terminale UNA SOLA VOLTA: va annotata subito. Nessun `admin/admin`.
# AEGIS_ADMIN_EMAIL=admin@aegis.local


# ── Rete ─────────────────────────────────────────────────────────────────────

# Ascolto dell'API.
# PORT=3001
# HOST=127.0.0.1

# Indirizzo dell'API visto dal server del frontend. Da cambiare solo se i due processi
# non stanno sulla stessa macchina.
# AEGIS_API_URL=http://127.0.0.1:3001

# In produzione impostare NODE_ENV=production: attiva il flag `secure` sul cookie di
# sessione, che a quel punto viaggia solo su HTTPS.
# NODE_ENV=production
